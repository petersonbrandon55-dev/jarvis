# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here

# ElevenLabs TTS (https://elevenlabs.io) — optional, falls back to pyttsx3
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here   # e.g. the "Jarvis" or "Adam" voice ID

# Tavily Web Search (https://tavily.com) — free tier available
TAVILY_API_KEY=your_key_here

# Picovoice wake word (https://console.picovoice.ai) — optional, enables "Hey Jarvis"
PICOVOICE_ACCESS_KEY=your_key_here

# Home Assistant (optional)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_token_here

# Obsidian vault path
OBSIDIAN_VAULT_PATH=/Users/brandonpeterson/Documents/Obsidian
